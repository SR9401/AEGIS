# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual env
.venv/
venv/
env/

# Package build
build/
dist/
*.egg-info/
.eggs/

# Caches & tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
.coverage
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# --- Flask / App ---
# Secrets & local config
.env
.env.*
*.secret
*.key

# Local DB (keep migrations, ignore real DB files)
app.db
*.sqlite
*.sqlite3

# Instance/var (if you use Flask instance folder)
instance/
var/
tmp/
logs/
*.log

# Alembic (KEEP migrations, just ignore bytecode)
alembic/*.pyc
alembic/__pycache__/

# Uploads (if you store files locally)
uploads/
media/

# --- Editors & OS ---
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# --- Front stuff (if any) ---
node_modules/
